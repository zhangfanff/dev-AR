+def custom_postprocess(detections, img_w, img_h):
+    """
+    把你的Detections预测结果转换为Yolact格式的4个标准化张量
+    （已提前过滤置信度>0.3，无需再过滤）
+    Args:
+        detections: 你的模型输出的Detections对象（xyxy、mask、confidence、class_id）
+        img_w: 原始图片宽度（像素）
+        img_h: 原始图片高度（像素）
+    Returns:
+        classes: torch.Tensor (N,) → 类别ID（适配Yolact格式）
+        scores: torch.Tensor (N,) → 置信度
+        boxes: torch.Tensor (N,4) → 绝对像素框（xyxy，已裁剪到图片内）
+        masks: torch.Tensor (N, img_h, img_w) → 原始尺寸二值掩码（0/1）
+    """
+    # 1. 提取你的预测结果字段（转numpy数组）
+    xyxy_np = detections.xyxy  # 边界框（xyxy格式，可能超界）
+    masks_np = detections.mask  # 二值掩码（shape=(N, H, W)）
+    confidence_np = detections.confidence  # 置信度（已过滤>0.3）
+    class_id_np = detections.class_id  # 类别ID
+
+    # 2. 裁剪边界框到图片内（核心：解决超界问题）
+    # 用np.clip替代Yolact的sanitize_coordinates，更简洁且效果一致
+    x1 = np.clip(xyxy_np[:, 0], 0, img_w)  # x1 ≥ 0 且 ≤ img_w
+    y1 = np.clip(xyxy_np[:, 1], 0, img_h)  # y1 ≥ 0 且 ≤ img_h
+    x2 = np.clip(xyxy_np[:, 2], 0, img_w)  # x2 ≥ 0 且 ≤ img_w
+    y2 = np.clip(xyxy_np[:, 3], 0, img_h)  # y2 ≥ 0 且 ≤ img_h
+    boxes_np = np.stack([x1, y1, x2, y2], axis=1).astype(np.int32)  # 转整数像素（符合图片坐标）
+
+    # 3. 掩码标准化（确保是0/1二值，且尺寸匹配原始图片）
+    masks_np = (masks_np > 0).astype(np.float32)  # False→0，True→1
+    # 校验掩码尺寸（避免维度不匹配导致指标计算错误）
+    assert masks_np.shape[1] == img_h and masks_np.shape[2] == img_w, (
+        f"掩码尺寸({masks_np.shape[1]}×{masks_np.shape[2]})与图片尺寸({img_h}×{img_w})不匹配！"
+    )
+
+    # 4. 转换为torch.Tensor（完全匹配Yolact格式）
+    classes = torch.from_numpy(class_id_np).long()
+    scores = torch.from_numpy(confidence_np).float()
+    boxes = torch.from_numpy(boxes_np).long()
+    masks = torch.from_numpy(masks_np).float()
+
+    return classes, scores, boxes, masks
+
+
